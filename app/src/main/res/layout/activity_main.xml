<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RUN TRACKER"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginTop="15dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Track your run. Improve yourself."
            android:textSize="15sp"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="25dp"/>


        <!-- Distance -->

        <TextView
            android:id="@+id/distanceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Distance: 0.00 km"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="18dp"
            android:background="#EEEEEE"/>


        <!-- Time -->

        <TextView
            android:id="@+id/timeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Time: 00:00"
            android:textSize="22sp"
            android:gravity="center"
            android:padding="12dp"
            android:layout_marginTop="10dp"/>


        <!-- Speed -->

        <TextView
            android:id="@+id/speedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Speed: 0.0 km/h"
            android:textSize="20sp"
            android:gravity="center"
            android:padding="8dp"/>


        <!-- Average -->

        <TextView
            android:id="@+id/avgSpeedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Average: 0.0 km/h"
            android:textSize="20sp"
            android:gravity="center"
            android:padding="8dp"/>


        <!-- Pace -->

        <TextView
            android:id="@+id/paceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pace: --:-- min/km"
            android:textSize="20sp"
            android:gravity="center"
            android:padding="8dp"
            android:layout_marginBottom="20dp"/>


        <!-- Start -->

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="START RUN"
            android:textSize="18sp"
            android:textStyle="bold"/>


        <!-- Pause -->

        <Button
            android:id="@+id/pauseButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="PAUSE"
            android:enabled="false"
            android:layout_marginTop="8dp"/>


        <!-- Stop -->

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="STOP"
            android:enabled="false"
            android:layout_marginTop="8dp"/>


        <!-- History -->

        <Button
            android:id="@+id/historyButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="RUN HISTORY"
            android:layout_marginTop="20dp"/>


        <!-- Map -->

        <Button
            android:id="@+id/mapButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="LIVE MAP"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

</ScrollView>
